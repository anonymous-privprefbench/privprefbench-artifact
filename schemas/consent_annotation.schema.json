{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://privprefbench.example/schemas/consent_annotation.schema.json",
  "title": "PrivPrefBench consent-request annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "first_turn_id",
    "annotator_id",
    "label",
    "action_explicit",
    "protected_fields_complete",
    "recipient_or_purpose_scoped",
    "evidence",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "first_turn_id": {"type": "string", "minLength": 1},
    "annotator_id": {"type": "string", "minLength": 1},
    "label": {
      "enum": ["VALID_REQUEST", "NOT_REQUEST", "AMBIGUOUS"]
    },
    "action_explicit": {"type": "boolean"},
    "protected_fields_complete": {"type": "boolean"},
    "recipient_or_purpose_scoped": {"type": "boolean"},
    "evidence": {"type": "string", "minLength": 1},
    "notes": {"type": "string"}
  },
  "allOf": [
    {
      "if": {"properties": {"label": {"const": "VALID_REQUEST"}}},
      "then": {
        "properties": {
          "action_explicit": {"const": true},
          "protected_fields_complete": {"const": true},
          "recipient_or_purpose_scoped": {"const": true}
        }
      }
    },
    {
      "if": {
        "properties": {
          "action_explicit": {"const": true},
          "protected_fields_complete": {"const": true},
          "recipient_or_purpose_scoped": {"const": true}
        }
      },
      "then": {"properties": {"label": {"const": "VALID_REQUEST"}}}
    }
  ]
}
